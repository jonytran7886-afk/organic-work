{
  "name": "organic-work",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 3100",
    "build": "next build --webpack",
    "start": "next start -p 3100",
    "db:setup": "tsx --env-file=.env scripts/db.ts setup",
    "db:bootstrap-admin": "tsx --env-file=.env scripts/db.ts bootstrap",
    "db:seed": "tsx --env-file=.env scripts/db.ts seed",
    "files:cleanup": "tsx --env-file=.env scripts/cleanup-uploads.ts",
    "test:integration": "node --env-file=.env scripts/run-tests.mjs integration",
    "test:e2e": "node --env-file=.env scripts/run-tests.mjs e2e",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests *.ts *.json *.mjs *.yml"
  },
  "dependencies": {
    "mongodb": "6.20.0",
    "next": "16.4.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
